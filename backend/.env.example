# ==============================================================================
# Asterline AI Research Assistant — Environment Configuration
# ==============================================================================

# LLM Provider Configuration
# Supported providers: gemini, openai, groq, mock / offline
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash

# API Keys (Optional — the system has a 100% offline grounded synthesizer fallback)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
GROQ_API_KEY=

# LangSmith Observability Configuration (Optional — offline local tracing is active by default)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=asterline-ai-assistant
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Server & Storage (Defaults are pre-configured)
API_V1_PREFIX=/api
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
